modules = ["nodejs-20", "web", "postgresql-16", "python-3.11"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "crud-guards"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lockfile-urls"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-external-resources"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "entity-list"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "note-rendering"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-providers"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "no-buffer-global"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "proof-verify-browser-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "proof-verify-node-check"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "crud-guards"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-crud-guards.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lockfile-urls"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-lockfile-urls.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-external-resources"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-no-external-resources.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "entity-list"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run client/src/lib/privacy-entity-list.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "note-rendering"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-note-rendering.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test-providers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-test-providers.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "no-buffer-global"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-no-buffer-global.js"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "proof-verify-browser-check"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-proof-verify-browser.mjs"

[[workflows.workflow]]
name = "proof-verify-node-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx vitest run client/src/lib/proofVerificationBrowserCheck.test.ts client/src/lib/signatureVerify.test.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_object_storage:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
