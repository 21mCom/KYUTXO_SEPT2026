[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-sparrow-mvdb-browser.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "descriptor-import-browser-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/check-descriptor-import-browser.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
