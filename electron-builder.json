{
  "appId": "com.kyutxo.app",
  "productName": "KYUTXO",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "client/public/**/*"
  ],
  "extraResources": [
    {
      "from": "client/public",
      "to": "public"
    }
  ],
  "win": {
    "target": ["portable"],
    "icon": "client/public/icon.png",
    "artifactName": "${productName}-${version}-Portable.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-${version}-Portable.${ext}"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "client/public/icon.png",
    "category": "public.app-category.finance"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "client/public/icon.png",
    "category": "Finance"
  }
}
