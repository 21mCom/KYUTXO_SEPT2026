{
  "appId": "com.kyutxo.app",
  "productName": "KYUTXO",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "client/public/**/*"
  ],
  "extraResources": [
    {
      "from": "client/public",
      "to": "public"
    }
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "client/public/icon.png"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "client/public/icon.png",
    "category": "public.app-category.finance"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "client/public/icon.png",
    "category": "Finance"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
